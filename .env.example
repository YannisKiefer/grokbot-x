# Copy to .env and fill. Never commit .env.

# Your X/Twitter handle without @
YOUR_HANDLE=yourhandle

# Typefully (Settings -> API). Connect YOUR_HANDLE via OAuth first.
YOUR_TYPEFULLY_API_KEY=
YOUR_TYPEFULLY_SOCIAL_SET_ID=

# Alias used in some docs / scripts
YOUR_SOCIAL_SET_ID=

# Optional. Defaults to ./skillopt next to this repo.
SKILLOPT_DIR=

# Optional. Used only for human-cadence notes, not by the scorer.
YOUR_TIMEZONE=America/New_York
